             PGM        PARM(&LIBP)
/*=================================================================*/
/* プログラム: COMPINIT                                             */
/* 概要  : 初期データ投入RPGプログラムのコンパイル               */
/* 修正#LIB: ライブラリー名をパラメーターで受け取る(例 O2CDEMO)    */
/*=================================================================*/

             DCL        VAR(&LIBP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGID) TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(512)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

/* 修正#LIB: ライブラリー名はパラメーターで受け取る(例 O2CDEMO)    */
             CHGVAR     VAR(&LIB) VALUE(&LIBP)
             MONMSG     MSGID(MCH3601) EXEC(DO)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('ライブラリー名を指定してください') +
                          MSGTYPE(*ESCAPE)
             ENDDO
/*   DDSのPFILEやRPGのファイルを見つけるためライブラリーリストに追加 */
             ADDLIBLE   LIB(&LIB)
             MONMSG     MSGID(CPF2103)

             SNDPGMMSG  MSG('初期化プログラムをコンパイル中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CRTRPGMOD  MODULE(&LIB/INITCODE) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITCODE) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITCODE) +
                          MODULE(&LIB/INITCODE) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('コードマスタ初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITWH) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITWH) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITWH) +
                          MODULE(&LIB/INITWH) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('倉庫マスタ初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITCUST) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITCUST) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITCUST) +
                          MODULE(&LIB/INITCUST) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('顧客マスタ初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITITEM) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITITEM) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITITEM) +
                          MODULE(&LIB/INITITEM) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('商品マスタ初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITFX) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITFX) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITFX) +
                          MODULE(&LIB/INITFX) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('為替レート初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITINV) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITINV) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITINV) +
                          MODULE(&LIB/INITINV) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('在庫初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTRPGMOD  MODULE(&LIB/INITUSER) +
                          SRCFILE(&LIB/QRPGLESRC) +
                          SRCMBR(INITUSER) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTPGM     PGM(&LIB/INITUSER) +
                          MODULE(&LIB/INITUSER) +
                          ACTGRP(*NEW) +
                          REPLACE(*YES) +
                          TEXT('ユーザーマスタ初期化')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CRTBNDCL   PGM(&LIB/INITDATA) +
                          SRCFILE(&LIB/QCLLESRC) +
                          SRCMBR(INITDATA) +
                          DBGVIEW(*SOURCE) +
                          REPLACE(*YES) +
                          TEXT('初期データ投入制御')
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             SNDPGMMSG  MSG('全初期化プログラムのコンパイルが完了しました') +
                          TOPGMQ(*EXT) MSGTYPE(*COMP)

             GOTO       CMDLBL(ENDPGM)

 ERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)
             SNDPGMMSG  MSG('コンパイルエラーが発生しました') +
                          TOPGMQ(*EXT) MSGTYPE(*DIAG)

 ENDPGM:    ENDPGM

