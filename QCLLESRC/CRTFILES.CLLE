/*=================================================================*/
/* プログラム: CRTFILES                                             */
/* 概要  : O2Cデータベースファイルの作成                            */
/* 修正#LIB: ライブラリー名をパラメーターで受け取る(例 O2CDEMO)    */
/*=================================================================*/
             PGM        PARM(&LIBP)

             DCL        VAR(&LIBP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGID) TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(512)
/* Mod#SEQ: SQLシーケンス作成用 */
             DCL        VAR(&SQL) TYPE(*CHAR) LEN(256)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

/* 修正#LIB: ライブラリー名はパラメーターで受け取る(例 O2CDEMO)    */
             CHGVAR     VAR(&LIB) VALUE(&LIBP)
             MONMSG     MSGID(MCH3601) EXEC(DO)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('ライブラリー名を指定してください') +
                          MSGTYPE(*ESCAPE)
             ENDDO

             CHKOBJ     OBJ(&LIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                             MSGDTA('ライブラリが見つかりません') +
                             MSGTYPE(*ESCAPE)
             ENDDO

             SNDPGMMSG  MSG('物理ファイルを作成中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CRTPF      FILE(&LIB/CUSTOMERP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('顧客マスタ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/ITEMP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('商品マスタ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/WAREHOUSEP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('倉庫マスタ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/INVENTORYP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('在庫')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/SORDERHP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('受注ヘッダ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/SORDERLP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('受注明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/SHIPMENTHP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('出荷ヘッダ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/SHIPMENTLP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('出荷明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/INVOICEHP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('請求書ヘッダ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/INVOICELP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('請求書明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/PAYMENTP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('入金')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/FXRATEP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('為替レート')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/CODEMSTRP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('コードマスタ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/APPUSERP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('アプリユーザー')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/CHANGELOGP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          LVLCHK(*NO) +
                          TEXT('変更ログ')
             MONMSG     MSGID(CPF7302)

/* Mod#SETUP: 入金充当明細(PAYENTRYで使用)も作成する */
             CRTPF      FILE(&LIB/PAYAPPLYP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('入金充当明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/DUNNINGP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('督促履歴')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/STKMOVEP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('在庫移動履歴')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/CUSTCLSP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('顧客締日')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/BILLSTMP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('請求締め履歴')
             MONMSG     MSGID(CPF7302)

/* 修正#NEW: 追加機能のファイル(返品・単価・見積・入金・発注・権限) */
             CRTPF      FILE(&LIB/RETURNP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('返品・値引き明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/PRICEP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('顧客別単価')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/QUOTEHP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('見積ヘッダ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/QUOTELP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('見積明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/BANKINP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('入金データ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/POHDRP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('発注ヘッダ')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/POLINEP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('発注明細')
             MONMSG     MSGID(CPF7302)

             CRTPF      FILE(&LIB/MENUAUTP) +
                          SRCFILE(&LIB/QDDSSRC) +
                          MAXMBRS(*NOMAX) SIZE(*NOMAX) +
                          TEXT('メニューの権限')
             MONMSG     MSGID(CPF7302)

             SNDPGMMSG  MSG('論理ファイルを作成中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CRTLF      FILE(&LIB/CUSTOMERL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('顧客コード順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/ITEML1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('商品コード順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/WAREHOUSL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('倉庫コード順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/INVENTORL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('在庫-商品順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/SORDERHL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('受注ヘッダ-番号順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/SORDERHL2) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('受注ヘッダ-顧客/日付順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/SORDERLL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('受注明細-商品順')
             MONMSG     MSGID(CPF7302)

/* Mod#SETUP: 請求/出荷処理で使う論理ファイル */
             CRTLF      FILE(&LIB/INVOICEHL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('請求ヘッダ-番号順')
             MONMSG     MSGID(CPF7302)

             CRTLF      FILE(&LIB/SHIPMENHL1) +
                          SRCFILE(&LIB/QDDSSRC) +
                          TEXT('出荷ヘッダ-受注順')
             MONMSG     MSGID(CPF7302)

/* Mod#SEQ: 採番用SQLシーケンス(既にあればそのまま) */
             SNDPGMMSG  MSG('採番シーケンスを作成中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_SOID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_INVID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_PAYID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_APPLYID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_LOGID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_SHPID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_DUNID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_MOVID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_STMID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

/* 修正#NEW: 追加機能の採番シーケンス */
             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_RETID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_PRICEID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_QTID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_BKID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

             CHGVAR     VAR(&SQL) VALUE('CREATE SEQUENCE ' *CAT +
                          &LIB *TCAT '.O2C_POID_SEQ AS BIGINT +
                          START WITH 1')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SQL)
             MONMSG     MSGID(SQL9010)

/* 修正#LOG: 変更履歴のトリガー(QSQLSRC の O2CTRIG。なければ飛ばす) */
             RUNSQLSTM  SRCFILE(&LIB/QSQLSRC) SRCMBR(O2CTRIG) +
                          COMMIT(*NONE) NAMING(*SQL) DFTRDBCOL(&LIB)
             MONMSG     MSGID(CPF0000 SQL0000)

             SNDPGMMSG  MSG('ファイル作成が完了しました') +
                          TOPGMQ(*EXT) MSGTYPE(*COMP)

             GOTO       CMDLBL(ENDPGM)

 ERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('ファイル作成エラー') +
                          MSGTYPE(*ESCAPE)

 ENDPGM:
             ENDPGM

