/*=================================================================*/
/* プログラム: SETUPJRN                                             */
/* 概要  : ジャーナル環境の設定                            */
/* 修正#LIB: ライブラリー名をパラメーターで受け取る(例 O2CDEMO)    */
/*=================================================================*/
             PGM        PARM(&LIBP)

             DCL        VAR(&LIBP) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGID) TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(512)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

/* 修正#LIB: ライブラリー名はパラメーターで受け取る(例 O2CDEMO)    */
             CHGVAR     VAR(&LIB) VALUE(&LIBP)
             MONMSG     MSGID(MCH3601) EXEC(DO)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('ライブラリー名を指定してください') +
                          MSGTYPE(*ESCAPE)
             ENDDO

             SNDPGMMSG  MSG('ジャーナルレシーバーを作成中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CRTJRNRCV  JRNRCV(&LIB/JRNRCV0001) +
                          TEXT('O2C Journal Receiver 0001')
             MONMSG     MSGID(CPF7010)

             SNDPGMMSG  MSG('ジャーナルを作成中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             CRTJRN     JRN(&LIB/O2CJRN) +
                          JRNRCV(&LIB/JRNRCV0001) +
                          MNGRCV(*SYSTEM) +
                          RCVSIZOPT(*RMVINTENT) +
                          TEXT('O2C Journal')
             MONMSG     MSGID(CPF7010)

             SNDPGMMSG  MSG('ジャーナルを開始中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             STRJRNPF   FILE(&LIB/CUSTOMERP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/ITEMP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/WAREHOUSEP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/INVENTORYP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/SORDERHP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/SORDERLP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/SHIPMENTHP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/SHIPMENTLP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/INVOICEHP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/INVOICELP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/PAYMENTP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

/* Mod#JRN: 入金充当明細もコミットメント制御で更新するため追加 */
             STRJRNPF   FILE(&LIB/PAYAPPLYP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/DUNNINGP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/STKMOVEP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/CUSTCLSP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/BILLSTMP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/FXRATEP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/CODEMSTRP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/APPUSERP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             STRJRNPF   FILE(&LIB/CHANGELOGP) +
                          JRN(&LIB/O2CJRN) +
                          IMAGES(*BOTH) OMTJRNE(*OPNCLO)
             MONMSG     MSGID(CPF7030)

             SNDPGMMSG  MSG('コミットメント制御を開始中...') +
                          TOPGMQ(*EXT) MSGTYPE(*INFO)

             STRCMTCTL  LCKLVL(*CHG) CMTSCOPE(*ACTGRP)
             MONMSG     MSGID(CPF8355)

             SNDPGMMSG  MSG('ジャーナル設定が完了しました') +
                          TOPGMQ(*EXT) MSGTYPE(*COMP)

             GOTO       CMDLBL(ENDPGM)

 ERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('ジャーナル設定エラー') +
                          MSGTYPE(*ESCAPE)

 ENDPGM:
             ENDPGM

