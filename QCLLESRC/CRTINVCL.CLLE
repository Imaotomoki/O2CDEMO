      /*=============================================================*/
      /* プログラム: CRTINVCL                                       */
      /* 概要  : 請求書作成呼び出しプログラム                        */
      /*          - CREATEINV (RPG) を呼び出す                       */
      /* パラメータ:                                                  */
      /*   &SOID   - 受注ID (18P 0 = 10バイト パック)                */
      /*   &CUSTID - 顧客ID  ( 9P 0 =  5バイト パック)               */
      /* 備考:                                                        */
      /*   RPG 18P 0 -> CL *CHAR LEN(10) (パック 10バイト)           */
      /*   RPG  9P 0 -> CL *CHAR LEN(5)  (パック  5バイト)           */
      /* 使用方法:                                                    */
      /*   CALL CRTINVCL PARM(&SOID &CUSTID)                         */
      /*   &SOID   TYPE(*CHAR) LEN(10)                               */
      /*   &CUSTID TYPE(*CHAR) LEN(5)                                */
      /*=============================================================*/
             PGM PARM(&SOID &CUSTID)

      /*-------------------------------------------------------------*/
      /* パラメーター定義                                            */
      /* RPGパック十進数はCLでは *CHAR として渡される:              */
      /*   18P 0 = ceiling((18+1)/2) = 10バイト -> *CHAR LEN(10)   */
      /*    9P 0 = ceiling(( 9+1)/2) =  5バイト -> *CHAR LEN(5)    */
      /*-------------------------------------------------------------*/
             DCL VAR(&SOID)   TYPE(*CHAR) LEN(10)
             DCL VAR(&CUSTID) TYPE(*CHAR) LEN(5)

      /*-------------------------------------------------------------*/
      /* 作業変数定義                                                */
      /*-------------------------------------------------------------*/
             DCL VAR(&MSGID)  TYPE(*CHAR) LEN(7)
             DCL VAR(&MSGDTA) TYPE(*CHAR) LEN(256)
      /* Mod#CMT: このプログラムで開始したコミット制御か       */
             DCL VAR(&OWNCMT) TYPE(*LGL) VALUE('1')

      /*-------------------------------------------------------------*/
      /* プログラムレベル エラーハンドラー                          */
      /*-------------------------------------------------------------*/
             MONMSG MSGID(CPF0000) EXEC(GOTO PGMERROR)

      /*=============================================================*/
      /* メイン処理                                                  */
      /*=============================================================*/

      /* --- コミットメント制御の開始 (Mod#CMT) --- */
      /* CREATEINVはCOMMIT付きでファイルを開くため、未開始だと  */
      /* CPF4326(コミットメント定義なし)でOPENエラーになる      */
             QSYS/STRCMTCTL LCKLVL(*CHG) CMTSCOPE(*JOB)
             MONMSG MSGID(CPF8351) EXEC(CHGVAR VAR(&OWNCMT) +
                          VALUE('0'))

      /* --- 請求書作成RPGプログラムの呼び出し --- */
             CALL PGM(CREATEINV) PARM(&SOID &CUSTID)

      /* --- コミットメント制御の終了 --- */
             IF COND(&OWNCMT) THEN(QSYS/ENDCMTCTL)

             RETURN

      /*=============================================================*/
      /* エラー処理                                                  */
      /*=============================================================*/
      PGMERROR:
             RCVMSG MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)

      /* コミットメント制御が有効な場合は終了する */
             IF COND(&OWNCMT) THEN(DO)
             QSYS/ENDCMTCTL
             MONMSG MSGID(CPF0000)
             ENDDO

      /* 呼び出し元へエスケープとして再送信する */
             SNDPGMMSG MSGID(CPF9898) MSGF(QCPFMSG) +
                       MSGDTA(&MSGID *TCAT ' - ' *CAT &MSGDTA) +
                       MSGTYPE(*ESCAPE)

             ENDPGM

