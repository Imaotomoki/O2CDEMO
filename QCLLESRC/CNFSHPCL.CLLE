      /*=============================================================*/
      /* プログラム: CNFSHPCL                                        */
      /* 概要  : 出荷確認呼び出しプログラム                          */
      /*         - コミットメント制御を開始する                      */
      /*         - CONFIRMSHP (RPG) を呼び出す                       */
      /*         - コミットメント制御を終了する                      */
      /* パラメータ:                                                  */
      /*   &SOID - 受注ID (18P 0 = 10バイト パック)                  */
      /*   &WHID - 倉庫ID  ( 4P 0 =  3バイト パック)                 */
      /* 備考:                                                        */
      /*   RPG 18P 0 -> CL *CHAR LEN(10)                             */
      /*   RPG  4P 0 -> CL *CHAR LEN(3)                              */
      /*=============================================================*/
             PGM PARM(&SOID &WHID &MODE &QTYS)

      /*-------------------------------------------------------------*/
      /* パラメーター定義                                            */
      /* RPGパック十進数はCLでは *CHAR として渡される:              */
      /*   18P 0 = ceiling((18+1)/2) = 10バイト -> *CHAR LEN(10)   */
      /*    4P 0 = ceiling(( 4+1)/2) =  3バイト -> *CHAR LEN(3)    */
      /*-------------------------------------------------------------*/
             DCL VAR(&SOID) TYPE(*CHAR) LEN(10)
             DCL VAR(&WHID) TYPE(*CHAR) LEN(3)
      /* Mod#PART: 出荷モード(A=全量 P=数量指定)と明細別出荷数量 */
      /*   15P 3 = 8バイト x 20明細 = 160バイト                   */
             DCL VAR(&MODE) TYPE(*CHAR) LEN(1)
             DCL VAR(&QTYS) TYPE(*CHAR) LEN(160)

      /*-------------------------------------------------------------*/
      /* 作業変数定義                                                */
      /*-------------------------------------------------------------*/
             DCL VAR(&MSGID)  TYPE(*CHAR) LEN(7)
             DCL VAR(&MSGDTA) TYPE(*CHAR) LEN(256)

      /*-------------------------------------------------------------*/
      /* プログラムレベル エラーハンドラー                          */
      /*-------------------------------------------------------------*/
             MONMSG MSGID(CPF0000) EXEC(GOTO PGMERROR)

      /*=============================================================*/
      /* メイン処理                                                  */
      /*=============================================================*/

      /* --- コミットメント制御の開始 --- */
      /* CMTSCOPE(*JOB): CONFIRMSHP が同じコミットメント定義を      */
      /* 共有するためジョブスコープを指定する                       */
             QSYS/STRCMTCTL LCKLVL(*CHG) +
                            CMTSCOPE(*JOB)

      /* --- 出荷確認RPGプログラムの呼び出し --- */
             CALL PGM(CONFIRMSHP) PARM(&SOID &WHID &MODE +
                          &QTYS)

      /* --- コミットメント制御の終了 --- */
             QSYS/ENDCMTCTL

             RETURN

      /*=============================================================*/
      /* エラー処理                                                  */
      /*=============================================================*/
      PGMERROR:
             RCVMSG MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)

      /* コミットメント制御が有効な場合は終了する */
             QSYS/ENDCMTCTL
             MONMSG MSGID(CPF0000)

      /* 呼び出し元へエスケープとして再送信する */
             SNDPGMMSG MSGID(CPF9898) MSGF(QCPFMSG) +
                       MSGDTA(&MSGID *TCAT ' - ' *CAT &MSGDTA) +
                       MSGTYPE(*ESCAPE)

             ENDPGM

