     A* ==========================================================
     A* CUSTMNTD - 顧客マスターの保守の画面
     A* 修正#MST: 新規作成。CUSTMNT から使う
     A*   全角の定数の直後は1桁空けて項目を置く(SIと属性桁の重なり防止)
     A* ==========================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'F3=終了')
     A                                      CF04(04 'F4=検索')
     A                                      CF06(06 'F6=新規')
     A                                      CA12(12 'F12=戻る')
     A                                      PRINT
     A* ---- LSFL - 顧客の一覧 ----
     A          R LSFL                      SFL
     A            LOPT           1A  B  7  2DSPATR(UL)
     A                                      VALUES(' ' '2' '4')
     A            LCUST         20A  O  7  4COLOR(GRN)
     A            LNAME         30A  O  7 25
     A            LCUR           3A  O  7 56
     A            LTAX          10A  O  7 60
     A            LSTS           8A  O  7 71
     A  61                                  COLOR(RED)
     A            LCUSTID        9S 0H
     A          R LCTL                      SFLCTL(LSFL)
     A                                      SFLSIZ(0999)
     A                                      SFLPAG(0014)
     A  91                                  SFLDSP
     A  92                                  SFLDSPCTL
     A  93                                  SFLCLR
     A  94                                  SFLEND(*MORE)
     A                                      OVERLAY
     A                                  1  2'顧客マスターの保守'
     A                                      DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'顧客コード'
     A            LFCUST        20A  B  3 16DSPATR(UL)
     A                                  3 38'(前方一致・空白=全部)'
     A                                      COLOR(BLU)
     A                                  4  2'2=変更 4=停止・再開'
     A                                      COLOR(BLU)
     A                                  4 30'F6=新規  Enter=検索'
     A                                      COLOR(BLU)
     A                                  6  4'顧客コード'
     A                                  6 25'顧客名'
     A                                  6 55'通貨'
     A                                  6 62'税区分'
     A                                  6 71'状態'
     A* ---- LFOOT ----
     A          R LFOOT
     A            LMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'F3=終了  F6=新規'
     A                                      COLOR(BLU)
     A* ---- DTL - 登録・変更 ----
     A          R DTL
     A                                      RTNCSRLOC(&CSRRCD &CSRFLD)
     A            CSRRCD        10A  H
     A            CSRFLD        10A  H
     A            DMODE         20A  O  1  2DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'顧客コード'
     A            DCUSTCD       20A  B  3 18DSPATR(UL)
     A  50                                  DSPATR(PR)
     A  31                                  DSPATR(RI PC)
     A                                  4  2'顧客名'
     A            DCUSTNM       60O  B  4 18DSPATR(UL)
     A  32                                  DSPATR(RI PC)
     A                                  5  2'請求先住所'
     A            DBILL         60O  B  5 18DSPATR(UL)
     A                                  6  2'配送先住所'
     A            DSHIP         60O  B  6 18DSPATR(UL)
     A                                  7  2'振込名義'
     A            DKANA         40A  B  7 18DSPATR(UL)
     A                                  7 60'(入金取込の照合)'
     A                                      COLOR(BLU)
     A                                  9  2'税区分'
     A            DTAXCAT       10A  B  9 18DSPATR(UL)
     A  33                                  DSPATR(RI PC)
     A            DTAXNM        30A  O  9 30COLOR(TRQ)
     A                                 10  2'通貨'
     A            DCURR          3A  B 10 18DSPATR(UL)
     A  34                                  DSPATR(RI PC)
     A                                 11  2'与信限度額'
     A            DCRED         15Y 2B 11 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  35                                  DSPATR(RI PC)
     A                                 11 40'(0=無制限)'
     A                                      COLOR(BLU)
     A                                 12  2'締日'
     A            DCLSDAY        2Y 0B 12 18EDTCDE(Z)
     A                                      DSPATR(UL)
     A  36                                  DSPATR(RI PC)
     A                                 12 40'(1-31、0=末日)'
     A                                      COLOR(BLU)
     A                                 13  2'状態'
     A            DSTS          10A  O 13 18COLOR(TRQ)
     A            DMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'Enter=登録  F4=検索'
     A                                      COLOR(BLU)
     A                                 23 30'F12=戻る'
     A                                      COLOR(BLU)
