     A* ==========================================================
     A* PRICEMNTD - 顧客別単価・数量割引の保守の画面
     A* 修正#PRC2: 新規作成。PRICEMNT から使う
     A*   全角の定数の直後は1桁空けて項目を置く(SIと属性桁の重なり防止)
     A* ==========================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'F3=終了')
     A                                      CF04(04 'F4=検索')
     A                                      CF06(06 'F6=新規')
     A                                      CA12(12 'F12=戻る')
     A                                      PRINT
     A* ---- LSFL - 単価の一覧 ----
     A          R LSFL                      SFL
     A            LOPT           1A  B  7  2DSPATR(UL)
     A                                      VALUES(' ' '2' '4')
     A            LCUST         12A  O  7  4COLOR(GRN)
     A            LITEM         12A  O  7 17
     A            LMINQ          8A  O  7 30
     A            LFROM         10A  O  7 39
     A            LTO           10A  O  7 50
     A            LPRC          14A  O  7 61DSPATR(HI)
     A            LID           18S 0H
     A          R LCTL                      SFLCTL(LSFL)
     A                                      SFLSIZ(0999)
     A                                      SFLPAG(0014)
     A  91                                  SFLDSP
     A  92                                  SFLDSPCTL
     A  93                                  SFLCLR
     A  94                                  SFLEND(*MORE)
     A                                      OVERLAY
     A                                  1  2'顧客別単価・数量割引の保守'
     A                                      DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'顧客コード'
     A            LFCUST        20A  B  3 16DSPATR(UL)
     A                                  3 38'(空白=全部 *=全顧客向け)'
     A                                      COLOR(BLU)
     A                                  4  2'2=変更 4=削除'
     A                                      COLOR(BLU)
     A                                  4 30'F6=新規  Enter=検索'
     A                                      COLOR(BLU)
     A                                  6  4'顧客'
     A                                  6 17'商品'
     A                                  6 30'最低数量'
     A                                  6 41'開始日'
     A                                  6 52'終了日'
     A                                  6 70'単価'
     A* ---- LFOOT ----
     A          R LFOOT
     A            LMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'F3=終了 F4=検索 F6=新規'
     A                                      COLOR(BLU)
     A* ---- DTL - 登録・変更 ----
     A          R DTL
     A                                      RTNCSRLOC(&CSRRCD &CSRFLD)
     A            CSRRCD        10A  H
     A            CSRFLD        10A  H
     A            DMODE         20A  O  1  2DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'顧客コード'
     A            DCUST         20A  B  3 18DSPATR(UL)
     A  31                                  DSPATR(RI PC)
     A                                  3 40'(空白=全顧客向け)'
     A                                      COLOR(BLU)
     A            DCUSTNM       40A  O  4 18COLOR(TRQ)
     A                                  5  2'商品コード'
     A            DITEM         12A  B  5 18DSPATR(UL)
     A  32                                  DSPATR(RI PC)
     A            DITEMNM       40A  O  6 18COLOR(TRQ)
     A                                  8  2'最低数量'
     A            DMINQ          9Y 0B  8 18EDTCDE(Z)
     A                                      DSPATR(UL)
     A  33                                  DSPATR(RI PC)
     A                                  8 40'(この数量以上で適用)'
     A                                      COLOR(BLU)
     A                                  9  2'開始日'
     A            DFROM          8Y 0B  9 18DSPATR(UL)
     A  34                                  DSPATR(RI PC)
     A                                 10  2'終了日'
     A            DTO            8Y 0B 10 18DSPATR(UL)
     A  35                                  DSPATR(RI PC)
     A                                 10 40'(0=期限なし)'
     A                                      COLOR(BLU)
     A                                 11  2'単価'
     A            DPRC          13Y 2B 11 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  36                                  DSPATR(RI PC)
     A                                 11 40'(顧客の通貨)'
     A                                      COLOR(BLU)
     A            DMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'Enter=登録  F4=検索'
     A                                      COLOR(BLU)
     A                                 23 30'F12=戻る'
     A                                      COLOR(BLU)
