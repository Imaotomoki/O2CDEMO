     A* ==========================================================
     A* ITEMMNTD - 商品マスターの保守の画面
     A* 修正#MST: 新規作成。ITEMMNT から使う
     A*   全角の定数の直後は1桁空けて項目を置く(SIと属性桁の重なり防止)
     A* ==========================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'F3=終了')
     A                                      CF04(04 'F4=検索')
     A                                      CF06(06 'F6=新規')
     A                                      CA12(12 'F12=戻る')
     A                                      PRINT
     A* ---- LSFL - 商品の一覧 ----
     A          R LSFL                      SFL
     A            LOPT           1A  B  7  2DSPATR(UL)
     A                                      VALUES(' ' '2' '4')
     A            LITEM         12A  O  7  4COLOR(GRN)
     A            LNAME         28A  O  7 17
     A            LPRC          14A  O  7 46
     A            LTAX          10A  O  7 61
     A            LSTS           8A  O  7 72
     A  61                                  COLOR(RED)
     A            LITEMID        9S 0H
     A          R LCTL                      SFLCTL(LSFL)
     A                                      SFLSIZ(0999)
     A                                      SFLPAG(0014)
     A  91                                  SFLDSP
     A  92                                  SFLDSPCTL
     A  93                                  SFLCLR
     A  94                                  SFLEND(*MORE)
     A                                      OVERLAY
     A                                  1  2'商品マスターの保守'
     A                                      DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'商品コード'
     A            LFITEM        12A  B  3 16DSPATR(UL)
     A                                  3 30'(前方一致・空白=全部)'
     A                                      COLOR(BLU)
     A                                  4  2'2=変更 4=停止・再開'
     A                                      COLOR(BLU)
     A                                  4 30'F6=新規  Enter=検索'
     A                                      COLOR(BLU)
     A                                  6  4'商品コード'
     A                                  6 17'商品名'
     A                                  6 50'標準単価'
     A                                  6 61'税区分'
     A                                  6 72'状態'
     A* ---- LFOOT ----
     A          R LFOOT
     A            LMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'F3=終了  F6=新規'
     A                                      COLOR(BLU)
     A* ---- DTL - 登録・変更 ----
     A          R DTL
     A                                      RTNCSRLOC(&CSRRCD &CSRFLD)
     A            CSRRCD        10A  H
     A            CSRFLD        10A  H
     A            DMODE         20A  O  1  2DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'商品コード'
     A            DITEMCD       12A  B  3 18DSPATR(UL)
     A  50                                  DSPATR(PR)
     A  31                                  DSPATR(RI PC)
     A                                  4  2'商品名'
     A            DITEMNM       40O  B  4 18DSPATR(UL)
     A  32                                  DSPATR(RI PC)
     A                                  5  2'単位'
     A            DUOM          10A  B  5 18DSPATR(UL)
     A                                  6  2'カテゴリ'
     A            DCAT          30A  B  6 18DSPATR(UL)
     A                                  8  2'標準単価'
     A            DPRC          15Y 2B  8 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  33                                  DSPATR(RI PC)
     A                                  9  2'標準原価'
     A            DCOST         15Y 2B  9 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  34                                  DSPATR(RI PC)
     A                                 10  2'税区分'
     A            DTAXCAT       10A  B 10 18DSPATR(UL)
     A  35                                  DSPATR(RI PC)
     A            DTAXNM        30A  O 10 30COLOR(TRQ)
     A                                 11  2'(空白=顧客の税区分)'
     A                                      COLOR(BLU)
     A                                 13  2'発注点'
     A            DROP          11Y 0B 13 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  36                                  DSPATR(RI PC)
     A                                 13 40'(0=発注しない)'
     A                                      COLOR(BLU)
     A                                 14  2'発注数量'
     A            DROQ          11Y 0B 14 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  37                                  DSPATR(RI PC)
     A                                 15  2'仕入先'
     A            DSUPP         20A  B 15 18DSPATR(UL)
     A  38                                  DSPATR(RI PC)
     A            DSUPNM        30A  O 15 40COLOR(TRQ)
     A                                 16  2'状態'
     A            DSTS          10A  O 16 18COLOR(TRQ)
     A            DMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'Enter=登録  F4=検索'
     A                                      COLOR(BLU)
     A                                 23 30'F12=戻る'
     A                                      COLOR(BLU)
