     A* ==========================================================
     A* FXMNTD - 為替レートの保守の画面
     A* 修正#MST: 新規作成。FXMNT から使う
     A*   全角の定数の直後は1桁空けて項目を置く(SIと属性桁の重なり防止)
     A* ==========================================================
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CA03(03 'F3=終了')
     A                                      CF04(04 'F4=検索')
     A                                      CF06(06 'F6=新規')
     A                                      CA12(12 'F12=戻る')
     A                                      PRINT
     A* ---- LSFL - レートの一覧(新しい順) ----
     A          R LSFL                      SFL
     A            LOPT           1A  B  7  2DSPATR(UL)
     A                                      VALUES(' ' '2' '4')
     A            LDATE         10A  O  7  4
     A            LFROM          3A  O  7 16COLOR(GRN)
     A            LTO            3A  O  7 22
     A            LRATE         14A  O  7 28
     A            LDATE8         8S 0H
     A          R LCTL                      SFLCTL(LSFL)
     A                                      SFLSIZ(0999)
     A                                      SFLPAG(0014)
     A  91                                  SFLDSP
     A  92                                  SFLDSPCTL
     A  93                                  SFLCLR
     A  94                                  SFLEND(*MORE)
     A                                      OVERLAY
     A                                  1  2'為替レートの保守'
     A                                      DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'通貨'
     A            LFCUR          3A  B  3 16DSPATR(UL)
     A                                  3 22'(空白=全部)'
     A                                      COLOR(BLU)
     A                                  4  2'2=変更 4=削除'
     A                                      COLOR(BLU)
     A                                  4 30'F6=新規  Enter=検索'
     A                                      COLOR(BLU)
     A                                  6  4'適用日'
     A                                  6 16'通貨'
     A                                  6 23'円'
     A                                  6 30'レート(1通貨=円)'
     A* ---- LFOOT ----
     A          R LFOOT
     A            LMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'F3=終了  F4=通貨検索'
     A                                      COLOR(BLU)
     A                                 23 30'F6=新規'
     A                                      COLOR(BLU)
     A* ---- DTL - 登録・変更 ----
     A          R DTL
     A            DMODE         20A  O  1  2DSPATR(HI)
     A                                  1 70DATE(*SYS) EDTCDE(Y)
     A                                  3  2'適用日'
     A            DDATE          8Y 0B  3 18DSPATR(UL)
     A  50                                  DSPATR(PR)
     A  31                                  DSPATR(RI PC)
     A                                  3 30'(YYYYMMDD)'
     A                                      COLOR(BLU)
     A                                  4  2'通貨'
     A            DFROM          3A  B  4 18DSPATR(UL)
     A  50                                  DSPATR(PR)
     A  32                                  DSPATR(RI PC)
     A                                  4 30'→ JPY'
     A                                  5  2'レート'
     A            DRATE         10Y 6B  5 18EDTCDE(J)
     A                                      DSPATR(UL)
     A  33                                  DSPATR(RI PC)
     A                                  5 40'(1通貨あたりの円)'
     A                                      COLOR(BLU)
     A            DMSG          78A  O 22  2COLOR(RED)
     A                                 23  2'Enter=登録  F4=通貨検索'
     A                                      COLOR(BLU)
     A                                 23 30'F12=戻る'
     A                                      COLOR(BLU)
